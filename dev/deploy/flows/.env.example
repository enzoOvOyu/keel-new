# Copy to .env.local (0600). Replace placeholders with unique local secrets.
KESTRA_DB_PASSWORD=REPLACE_WITH_RANDOM_SECRET
KESTRA_USERNAME=keel@local.invalid
KESTRA_PASSWORD=REPLACE_WITH_STRONG_MIXED_CASE_PASSWORD
KESTRA_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY
KESTRA_URL=http://127.0.0.1:8095
# Application database is separate from Kestra engine database.
DATABASE_URL=postgres://USER:PASSWORD@DB_HOST:5432/keel_flows_dev?sslmode=disable
LISTEN_ADDR=127.0.0.1:8096
# Docker engine must be able to reach this address; never use its own localhost.
KEEL_WORKER_CALLBACK_URL=http://host.docker.internal:8096
KEEL_BOOTSTRAP_PASSWORD=REPLACE_WITH_NEW_ISOLATED_ADMIN_PASSWORD
KEEL_AGENT_GATEWAY_ADDR=127.0.0.1:8097
KEEL_AGENT_ENROLL_ADDR=127.0.0.1:8098
KEEL_AGENT_CA_CERT=/ABSOLUTE_PRIVATE_PATH/pki/ca.pem
KEEL_AGENT_CA_KEY=/ABSOLUTE_PRIVATE_PATH/pki/ca-key.pem
KEEL_AGENT_SERVER_CERT=/ABSOLUTE_PRIVATE_PATH/pki/server.pem
KEEL_AGENT_SERVER_KEY=/ABSOLUTE_PRIVATE_PATH/pki/server-key.pem
KEEL_SSH_SECRET_DIR=/ABSOLUTE_PRIVATE_PATH/secrets
# Bootstrap is disabled until HTTPS package/CA/service prerequisites are provisioned.
KEEL_AGENT_PACKAGE_URL=
KEEL_AGENT_PACKAGE_SHA256=
KEEL_PUBLIC_HTTPS_URL=
KEEL_AGENT_PUBLIC_GATEWAY=
