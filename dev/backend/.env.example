DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/keel?sslmode=disable
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=controlled-local-key
S3_SECRET_KEY=controlled-local-secret
S3_BUCKET=keel-dev
KEEL_PROJECT_ID=proj-b300-demo
DEV_ORIGIN=http://localhost:5174
APP_ENV=development
# First startup only: initializes admin if app_user is empty; never resets existing passwords.
KEEL_BOOTSTRAP_PASSWORD=replace-with-a-unique-at-least-12-character-password
# Acceptance scripts only, not authentication bypass settings.
KEEL_LOGIN_USER=admin
KEEL_LOGIN_PASSWORD=the-same-controlled-local-admin-password
# Optional server-only Provider configuration; do not use VITE_ variables for keys.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=30
AI_TOKEN_BUDGET=2048
